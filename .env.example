# With no DATABASE_URL, the app uses an in-memory PostgreSQL emulator.
# Demo bookings disappear when the server restarts.
PORT=3000
HOST=127.0.0.1

# Uncomment to use a real PostgreSQL database you have already created.
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/tatkal_shield

# Optional. Use a test gateway and test merchant credentials.
# YOUPI_SANDBOX_API_URL=http://localhost:6100
# YOUPI_SANDBOX_CHECKOUT_ORIGIN=http://localhost:6200
# YOUPI_SANDBOX_MERCHANT_ID=
# YOUPI_SANDBOX_MERCHANT_KEY=
# RAILKIT_API_KEY=
